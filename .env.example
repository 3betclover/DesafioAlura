# Copia este archivo como .env y completa la clave del proveedor que uses.
# Basta con definir una de las dos.

# Opción recomendada: nivel gratuito, no pide tarjeta de crédito.
# Se obtiene en https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Alternativa: requiere una cuenta con saldo.
# Se obtiene en https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Proveedor a usar: "google" u "openai".
# Si se deja vacío, se elige automáticamente según la clave disponible,
# dando prioridad a Google.
PROVEEDOR=

# Modelos. Si se dejan vacíos se usan los predeterminados de cada proveedor:
#   google -> gemini-2.5-flash
#   openai -> gpt-4.1-mini (visión) y gpt-4.1 (razonamiento)
MODELO_VISION=
MODELO_RAZONAMIENTO=
